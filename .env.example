# Copy to .env (local) or set these in your host's dashboard. NEVER commit .env.
NODE_ENV=production
SESSION_SECRET=paste-64-random-hex-chars-here
OWNER_EMAIL=you@example.com
# Used ONCE to create the owner account on first start. Min 12 chars. Remove after first boot.
OWNER_PASSWORD=
# Folder for the database + uploaded images. Must be a persistent disk/volume in production.
DATA_DIR=./data
